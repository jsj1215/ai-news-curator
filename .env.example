# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Telegram
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_CHAT_ID=your-telegram-chat-id

# Admin (/admin/**, /api/pipeline/**, /h2-console 접근용 HTTP Basic 계정)
# 로컬에서 비워두면 기동할 때마다 임시 비밀번호를 만들어 로그에 출력함. docker-compose(prod)에서는 필수
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# JWT
# 로컬은 주석 그대로 두면 개발용 기본값 사용. docker-compose(prod)에서는 필수
# 생성 예: openssl rand -base64 48
# JWT_SECRET=

# Database (PostgreSQL)
DB_NAME=ainews
DB_USERNAME=ainews
DB_PASSWORD=ainews
